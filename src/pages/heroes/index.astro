---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeroCard from '../../components/HeroCard.astro';

const allHeroes = await getCollection('heroes');
const heroes = allHeroes.filter((h) => h.data.visible !== false).sort((a, b) => a.data.surname.localeCompare(b.data.surname));
---

<PageLayout
  title="I nostri heroes!"
  subtitle="Le persone che organizzano e fanno crescere GDG Pisa, evento dopo evento."
  description="Hall of Fame di GDG Pisa: organizzatori e collaboratori."
>
  <a class="sticker-pill back-home" href="/">← Torna alla home</a>
  <div class="card-grid">
    {
      heroes.map((h) => (
        <HeroCard
          name={h.data.name}
          info={h.data.info}
          image={h.data.image}
          github={h.data.github}
          facebook={h.data.facebook}
          instagram={h.data.instagram}
          linkedin={h.data.linkedin}
          link={h.data.link}
          tags={h.data.tags}
        />
      ))
    }
  </div>
</PageLayout>

<style>
  .back-home {
    margin-bottom: var(--space-4);
  }
</style>
